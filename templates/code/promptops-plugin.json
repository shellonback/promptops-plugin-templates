{
  "schemaVersion": 1,
  "id": "your-handle.github-pull-requests",
  "name": "GitHub Pull Requests",
  "version": "0.1.0",
  "category": "code",
  "description": "Shows open pull requests and their CI checks next to your sessions.",
  "minAppVersion": "2.1.0",
  "entry": "src/plugin.js",
  "permissions": ["net:api.github.com", "secrets"],
  "config": {
    "fields": [
      { "key": "repo", "type": "text", "label": "Default repository (owner/name)", "default": "octo-org/storefront" },
      { "key": "token", "type": "secret", "label": "GitHub token (optional for public repos)" }
    ]
  }
}
